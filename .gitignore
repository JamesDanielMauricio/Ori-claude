# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.turbo/
out/
.vercel/

# env
.env
.env.local
.env.*.local

# contains a live MCP bearer token — never commit
.mcp.json

# SECURITY: Claude Code's personal settings for one machine (for example,
# which MCP servers that person approved). Allows each developer to keep
# their own; protects against publishing them in this public repo from a
# computer whose own git settings don't already ignore the file. The shared
# rules live in .claude/settings.json, which IS committed.
.claude/settings.local.json

# Bubble data snapshots (packages/db/scripts/bubble-export.ts) — real
# people's emails and phone numbers; never commit
.bubble-export/

# SECURITY: the dev project's test logins and their passwords, written by
# packages/db/scripts/seed-dev.ts. Allows the developer to keep them on
# their own computer; protects against publishing working passwords in this
# public repo (dev holds only made-up data, but its logins still sign in).
/dev-logins.local.txt

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# test / coverage
coverage/
playwright-report/
test-results/

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# os
.DS_Store
Thumbs.db

# typescript
*.tsbuildinfo
